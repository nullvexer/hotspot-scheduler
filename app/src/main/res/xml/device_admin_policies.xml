<?xml version="1.0" encoding="utf-8"?>
<!--
  The app requests exactly one device policy capability: force-lock, which backs
  DevicePolicyManager.lockNow(). That is the only public API an app has to turn the screen off.

  No password quality policy, no wipe-data, no disable-camera, no password reset. The user sees
  this list in Settings before granting the administrator.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>